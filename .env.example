# CloudQR Environment Variables Template
# Copy this file to .env for local testing or configure in the Render Dashboard

# Flask Environment Configuration
FLASK_ENV=production
FLASK_DEBUG=0

# Security Secret Key (Required in Production: Generate a 32+ character random string)
SECRET_KEY=generate-a-secure-random-32-byte-secret-key-here

# Database Connection String
# On Render: Use the Internal Database URL provided by your Render PostgreSQL service
DATABASE_URL=postgresql://cloud_qr_user:your_secure_password@dpg-hostname:5432/cloud_qr_db

# Secure Cookie Flag (Set to true in production over HTTPS)
SESSION_COOKIE_SECURE=true

# Server Port (Injected automatically by Render, defaults to 10000)
PORT=10000

# Concurrency Tuning
WEB_CONCURRENCY=2
